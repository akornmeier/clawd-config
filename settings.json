{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "PINECONE_SKIP_AUTH_CHECK": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(git:*)",
      "Bash(mkdir:*)",
      "Bash(uv:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(grep:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Write",
      "Edit",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(osascript *)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "strategy-awareness": "off",
    "od-design-shape": "off",
    "improve-animations": "off",
    "find-animation-opportunities": "off",
    "find-skills": "off",
    "cmux": "off",
    "worktree-manager-skill": "off",
    "review-animations": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script ~/.claude/hooks/pre_tool_use.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "vercel@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "pinecone@claude-plugins-official": true,
    "scroll-world@scroll-world": true,
    "ponytail@ponytail": true,
    "superpowers@superpowers-dev": true,
    "impeccable@impeccable": true,
    "explain-this@explain-this": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "scroll-world": {
      "source": {
        "source": "github",
        "repo": "oso95/scroll-world"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "explain-this": {
      "source": {
        "source": "github",
        "repo": "analyticalmonk/explain-this"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "teammateMode": "tmux",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
